# LLM provider (only "ollama" is implemented for now)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434

# Layer 1 (per-file diff analysis) uses the fast model; layers 2-3 use the strong model.
LLM_MODEL_FAST=qwen3.5:9b
LLM_MODEL_STRONG=qwen3.5:9b
# Enable model "thinking" for layers 2-3 (slower, sometimes better synthesis)
LLM_THINK_STRONG=false

# Context window passed to Ollama; diffs are truncated to fit.
NUM_CTX=16384
MAX_DIFF_CHARS=20000

# Parallel LLM calls per superstep. Keep low for a single local Ollama instance.
MAX_CONCURRENCY=2

# SQLite file holding the LangGraph checkpoints and the analysis cache.
DB_PATH=gitscribe.db
