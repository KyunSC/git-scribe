# Shared by fastapi-backend and frontend. Copy to .env (gitignored) and edit.

# --- backend ----------------------------------------------------------------

# LLM provider: "ollama", or "fake" for canned offline answers (UI development without a model)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434

# Layer 1 (per-file diff analysis) uses the fast model; layers 2-3 use the strong model.
LLM_MODEL_FAST=qwen3.5:9b
LLM_MODEL_STRONG=qwen3.5:9b
# Enable model "thinking" for layers 2-3 (slower, sometimes better synthesis)
LLM_THINK_STRONG=false

# Context window passed to Ollama; diffs are truncated to fit.
NUM_CTX=16384
MAX_DIFF_CHARS=20000

# Parallel LLM calls per superstep. Keep low for a single local Ollama instance.
MAX_CONCURRENCY=2

# SQLite file holding the LangGraph checkpoints and the analysis cache (relative to where the backend runs).
DB_PATH=gitscribe.db

# Where GitHub repositories are cloned (bare) for analysis (relative to where the backend runs).
REPOS_DIR=repos
# Optional GitHub token: needed for private repos, and raises the API rate limit (60/hour without one).
GITHUB_TOKEN=

# Browser origins allowed to call the API (comma-separated), e.g. the Next.js dev server.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- frontend ---------------------------------------------------------------

# Where the browser reaches the backend API. Inlined at build time: restart `npm run dev` after changing.
NEXT_PUBLIC_API_URL=http://localhost:8000
